{
  "name": "postiz-docs",
  "private": true,
  "description": "Postiz documentation, built with Mintlify",
  "scripts": {
    "dev": "mint dev",
    "check": "node scripts/check-docs.mjs && node scripts/check-prose.mjs",
    "check:structure": "node scripts/check-docs.mjs",
    "check:prose": "node scripts/check-prose.mjs",
    "check:links": "mint broken-links"
  },
  "devDependencies": {
    "mint": "^4"
  }
}
